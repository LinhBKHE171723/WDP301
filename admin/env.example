# ============================================
# ADMIN FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# cp env.example .env

# Backend API URL
# Development: http://localhost:5000/api
# Production: https://YOUR_DOMAIN.com/api
REACT_APP_API_URL=http://localhost:5000/api

# WebSocket URL (optional, will be derived from API_URL if not set)
# Development: ws://localhost:5000/ws
# Production: wss://YOUR_DOMAIN.com/ws
REACT_APP_WS_URL=ws://localhost:5000/ws

