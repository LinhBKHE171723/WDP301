# API Configuration
# Base URL for the backend API
# For production, set this to your deployed backend URL (e.g., https://api.yourdomain.com/api)
REACT_APP_API_URL=http://localhost:5000/api

# WebSocket Configuration (optional)
# If not set, will be automatically derived from REACT_APP_API_URL
# For production, set this to your WebSocket URL (e.g., wss://api.yourdomain.com/ws)
REACT_APP_WS_URL=ws://localhost:5000/ws
